PORT=5000
DATABASE_URL=postgresql://user:password@localhost:5432/bug_reporter

# Resend API Key (starts with re_)
RESEND_API_KEY=re_your_api_key_here

# The email address that will receive the bug reports
NOTIFICATION_EMAIL=your.email@example.com

# Comma separated list of allowed origins for CORS. Leave empty or * to allow all (not recommended for production)
ALLOWED_ORIGINS=http://localhost:5173,https://yourwebsite.com
